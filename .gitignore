/.pio
/.vscode
/.venv/
/.tools/
/releases/
/dist/
/.claude
__pycache__/
*.pyc
.pytest_cache/
build
tools/lvgl_native_preview/build/
preview_output/lvgl_*/
BrowserWrapper/bin/
BrowserWrapper/obj/

# Native preview renderer build trees (regenerated by render_lvgl_native.py).
# "build" alone matched only bare directory names, not these siblings, and the
# glob also covers throwaway trees such as a symbols build made to debug a crash.
tools/lvgl_native_preview/build_*/
/.playwright-cli/
/output/playwright/
/output/
preview_output/**/*.ppm
preview_output/test_*/
# Ad-hoc dashboard review renders; the checked-in set is preview_output/lvgl/*.png.
preview_output/lvgl/review/
preview_output/lvgl/review_dark/
preview_output/lvgl/dev_test/
preview_output/lvgl/panel_profile_review/
preview_output/lvgl/pixel_reference_review/
# Capture folders the docs render into (ride-replay.md, simulator.md).
preview_output/replay*/
preview_output/scratch/
# Runtime logs from the layout editor wrapper; the directory is created on demand.
logs/
# BrowserWrapper build output. It is produced by dotnet build, not shipped.
wrapper_verify_build/

# The companion app is closed source and lives in its own private repository,
# checked out here so its build can read include/config.h and the firmware
# sources. It must never be committed to this one.
/android-companion/

# Remembers where the offline signing key lives on this machine. The path only,
# never the password -- but the location of a release key is not for publishing.
/tools/firmware_update/release.local.json
